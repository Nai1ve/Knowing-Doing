VITE_API_BASE_URL=/api
# Vite proxies browser API requests to this host during local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Fixtures are opt-in; production and ordinary development call the real API.
VITE_ENABLE_LEARNING_FIXTURES=false
VITE_ZHIHU_OAUTH_ENABLED=false
VITE_ZHIHU_SOURCE_SYNC_ENABLED=false
# Roll out Practice Card v2 and Mixed Gym independently from the legacy flow.
VITE_PRACTICE_CARD_V2_ENABLED=false
VITE_MIXED_GYM_ENABLED=false
VITE_LEGACY_CASE_FLOW_ENABLED=true
