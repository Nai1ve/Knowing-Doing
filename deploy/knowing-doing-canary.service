[Unit]
Description=Knowing-Doing API (canary :3002)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/knowing-doing-canary/backend
EnvironmentFile=/etc/knowing-doing/backend.env
# Canary overrides are applied AFTER the shared production env file, so these
# win. Every business flag stays OFF: the staged release exercises the new
# schema and code safely while production keeps its current behavior. The
# OAuth origin/callback is pinned to the production host by config.ts, so
# real OAuth is validated during the staged rollout, not on the canary port.
Environment=LAB_API_PORT=3002
Environment=LAB_CORS_ORIGIN=http://119.45.243.102:8082
Environment=SIGNED_DEVICE_SESSION_ENABLED=false
Environment=ZHIHU_OAUTH_ENABLED=false
Environment=ZHIHU_LOGIN_REQUIRED=false
Environment=ZHIHU_SOURCE_SYNC_ENABLED=false
Environment=ZHIHU_RESEARCH_ENABLED=false
Environment=PLANNER_ASSESSMENT_V2_ENABLED=false
Environment=PRACTICE_CARD_V2_ENABLED=false
Environment=MIXED_GYM_ENABLED=false
Environment=LEGACY_CASE_FLOW_ENABLED=true
ExecStart=/usr/bin/node /home/ubuntu/knowing-doing-canary/backend/dist/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
