# Copy these names into GitHub repository Settings -> Secrets and variables -> Actions.
# Values are intentionally omitted from this tracked template.

DEPLOY_HOST=119.45.243.102
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
DEPLOY_SSH_KEY=<dedicated-private-key>

# Required by the production API.
LAB_TOKEN_SECRET=<long-random-secret>
WORKSPACE_RUNNER_TOKEN=<long-random-secret>
ZHIXING_MODEL_BASE_URL=https://api.deepseek.com
ZHIXING_MODEL_API_KEY=<deepseek-api-key>
ZHIXING_MODEL_NAME=deepseek-flash

# Optional if Zhihu node knowledge routes are enabled.
ZHIXING_ZHIHU_ACCESS_SECRET=<zhihu-access-secret>

# Optional production MySQL credentials. The Docker mysql.env remains a separate
# server-side file used by deploy/bootstrap-mysql.sh.
LAB_MYSQL_RUNNER_PASSWORD=<lab-runner-password>
LAB_MYSQL_ADMIN_PASSWORD=<lab-admin-password>

# Required when the repository variable CASE_BUILDER_ENABLED=true.
CASE_BUILDER_TOKEN=<long-random-secret>
ENVIRONMENT_RUNTIME_SIGNING_KEY=<different-long-random-secret>
CASE_BUILDER_MYSQL_ROOT_PASSWORD=<per-case-mysql-root-password>

# Optional; otherwise the existing DeepSeek settings above are reused.
CASE_BUILDER_LLM_BASE_URL=https://api.deepseek.com
CASE_BUILDER_LLM_API_KEY=<deepseek-api-key>
CASE_BUILDER_LLM_MODEL=deepseek-flash

# Repository variable, not a secret; optional because the GitHub Actions image
# job has a digest-pinned default. The resulting task image is published to
# ghcr.io/nai1ve/knowing-doing-case-builder-agent.
CASE_BUILDER_OPENHANDS_BASE_IMAGE=ghcr.io/openhands/openhands@sha256:<64-hex-digest>
