# Configure these as GitHub repository Actions Secrets.
# Do not commit real values to this file.

DEPLOY_HOST=119.45.243.102
DEPLOY_USER=ubuntu
# Optional; the workflow defaults to 22.
DEPLOY_PORT=22
DEPLOY_SSH_KEY=

LAB_TOKEN_SECRET=
WORKSPACE_RUNNER_TOKEN=
LAB_MYSQL_RUNNER_PASSWORD=
LAB_MYSQL_ADMIN_PASSWORD=
ZHIXING_MODEL_API_KEY=

# Optional because the workflow supplies these defaults.
ZHIXING_MODEL_BASE_URL=https://api.deepseek.com
ZHIXING_MODEL_NAME=deepseek-flash

# Required when CASE_BUILDER_ENABLED=true. Build the digest-pinned OpenHands
# task image directly on the deployment host with setup-case-builder-agent.sh.
CASE_BUILDER_TOKEN=
ENVIRONMENT_RUNTIME_SIGNING_KEY=
CASE_BUILDER_MYSQL_ROOT_PASSWORD=

# Optional overrides. Omit to reuse ZHIXING_MODEL_* / DeepSeek Flash.
CASE_BUILDER_LLM_BASE_URL=https://api.deepseek.com
CASE_BUILDER_LLM_API_KEY=
CASE_BUILDER_LLM_MODEL=deepseek-flash
