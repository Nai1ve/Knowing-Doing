NODE_ENV=production

LAB_API_HOST=127.0.0.1
LAB_API_PORT=3001
LAB_CORS_ORIGIN=http://119.45.243.102
LAB_MYSQL_HOST=127.0.0.1
LAB_MYSQL_PORT=13306
LAB_MYSQL_RUNNER_USER=zhixing_lab_runner
LAB_MYSQL_RUNNER_PASSWORD=
LAB_MYSQL_ADMIN_USER=zhixing_lab_admin
LAB_MYSQL_ADMIN_PASSWORD=
LAB_TOKEN_SECRET=

LAB_RUN_LEASE_MS=1200000
LAB_RUN_IDLE_TIMEOUT_MS=300000
LAB_QUEUE_LEASE_MS=1800000
LAB_QUERY_TIMEOUT_MS=10000
LAB_MAX_ROWS=200
LAB_MAX_OUTPUT_BYTES=1048576
LAB_RUNNER_POOL_SIZE=6

ZHIXING_PRODUCT_DB_PATH=/home/ubuntu/knowing-doing-data/zhixing-product.db
ZHIXING_MODEL_BASE_URL=https://api.deepseek.com
ZHIXING_MODEL_API_KEY=
ZHIXING_MODEL_NAME=deepseek-flash
ZHIXING_MODEL_TIMEOUT_MS=300000
ZHIXING_ZHIHU_CLI_PATH=
ZHIXING_ZHIHU_ACCESS_SECRET=
ZHIXING_ZHIHU_API_BASE_URL=https://developer.zhihu.com
ZHIXING_RETRIEVAL_TIMEOUT_MS=15000
ZHIXING_RETRIEVAL_CACHE_TTL_MS=86400000

# Zhihu OAuth is deliberately off until the exact HTTP IP callback has been
# accepted by the Zhihu application. Enabling HTTP OAuth also requires the
# explicit insecure transport acknowledgement below.
PUBLIC_ORIGIN=http://119.45.243.102
SIGNED_DEVICE_SESSION_ENABLED=false
ZHIHU_OAUTH_ENABLED=false
ZHIHU_SOURCE_SYNC_ENABLED=false
ALLOW_INSECURE_OAUTH_CALLBACK=true
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_SCOPES=
ZHIHU_OAUTH_BASE_URL=https://openapi.zhihu.com
ZHIHU_OAUTH_AUTHORIZE_PATH=/authorize
ZHIHU_OAUTH_TOKEN_PATH=/access_token
ZHIHU_OAUTH_USER_PATH=/user
ZHIHU_OAUTH_COLLECTIONS_PATH=/user/collections
ZHIHU_OAUTH_COLLECTION_ITEMS_PATH=/user/collection/{collection_id}
ZHIHU_OAUTH_CONTENT_PATH=/user/content
ZHIHU_OAUTH_MOMENTS_PATH=/user/moments
ZHIHU_OAUTH_REDIRECT_URI=http://119.45.243.102/api/auth/oauth/zhihu/callback
OAUTH_TOKEN_ENCRYPTION_KEY=

# Enables the server-owned Planner assessment generator; keep false until rollout is verified.
PLANNER_ASSESSMENT_V2_ENABLED=false
PRACTICE_CARD_V2_ENABLED=false
MIXED_GYM_ENABLED=false
LEGACY_CASE_FLOW_ENABLED=true
WORKSPACE_RUNNER_URL=http://127.0.0.1:3101
WORKSPACE_RUNNER_TOKEN=

# The deployment workflow writes the feature flag; set the repository variable
# CASE_BUILDER_ENABLED=false to pause the Builder.
CASE_BUILDER_ENABLED=false
CASE_BUILDER_URL=http://127.0.0.1:3102
CASE_BUILDER_TOKEN=
CASE_BUILDER_TASK_TIMEOUT_MS=1200000
CASE_BUILDER_MAX_REPAIR_ROUNDS=3
CASE_BUILDER_MAX_CONCURRENT=1
CASE_BUILDER_MAX_LOG_BYTES=65536
CASE_BUILDER_FAILURE_RETENTION_HOURS=24
ENVIRONMENT_RUNTIME_SIGNING_KEY=
ENVIRONMENT_RUNTIME_REFERENCE_TTL_MS=600000
