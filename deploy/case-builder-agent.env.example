# Installed by the deployment workflow; never commit real values.
# The deployment host builds and owns the OpenHands task image. Run
# setup-case-builder-agent.sh after installing the secrets below.
CASE_BUILDER_TOKEN=
CASE_BUILDER_OPENHANDS_IMAGE=
CASE_BUILDER_OPENHANDS_COMMAND=/app/.venv/bin/python /usr/local/bin/zhixing-openhands-build.py
CASE_BUILDER_LLM_BASE_URL=https://api.deepseek.com
CASE_BUILDER_LLM_API_KEY=
CASE_BUILDER_LLM_MODEL=deepseek-flash
CASE_BUILDER_MYSQL_ROOT_PASSWORD=
CASE_BUILDER_TASK_TIMEOUT_MS=1200000
CASE_BUILDER_MAX_CONCURRENT=1
CASE_BUILDER_MAX_LOG_BYTES=65536
CASE_BUILDER_MAX_REQUEST_BYTES=2097152
CASE_BUILDER_MAX_RUNTIME_IMAGE_BYTES=4294967296
CASE_BUILDER_TASK_MEMORY=4g
CASE_BUILDER_TASK_CPUS=2
CASE_BUILDER_TASK_PIDS=512
CASE_BUILDER_MYSQL_MEMORY=1024m
CASE_BUILDER_MYSQL_CPUS=1
CASE_BUILDER_MYSQL_PIDS=256
CASE_BUILDER_MYSQL_RUNTIME_LEASE_MS=1200000
CASE_BUILDER_MYSQL_EXECUTION_TIMEOUT_MS=10000
