# The deployment host builds this extension image once from a digest-pinned
# OpenHands base. GitHub Actions deploys the product services around it.
ARG OPENHANDS_BASE_IMAGE=docker.openhands.dev/openhands/openhands@sha256:03b8978743d4597d99d85385b5fa258e8dba8d360b30a7416182d7fa82c1e89c
FROM ${OPENHANDS_BASE_IMAGE}

USER root
LABEL zhixing.component="case-builder-agent"
RUN apt-get update \
  && apt-get install -y --no-install-recommends docker.io docker-compose default-mysql-client python3 python3-pip ca-certificates \
  && /app/.venv/bin/pip install --no-cache-dir pytest==8.4.1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY openhands-build.py /usr/local/bin/zhixing-openhands-build.py
# Debian's docker.io package in the pinned base supplies daemon integration but
# not a usable `docker` client binary in this image. The setup script stages
# the deployment host's static CLI beside this Dockerfile; it is used only to
# talk to the explicitly mounted Docker socket.
COPY docker /usr/local/bin/docker
RUN chmod 0755 /usr/local/bin/zhixing-openhands-build.py /usr/local/bin/docker \
  && docker --version

# OpenHands executes the generated verification commands through its terminal
# using PATH.  The base image deliberately keeps its SDK dependencies in
# /app/.venv, so make that interpreter (and pytest) the default for both the
# agent and this wrapper's independent `python3 -m pytest` preflight.
ENV VIRTUAL_ENV=/app/.venv
ENV PATH=/app/.venv/bin:${PATH}
ENV OPENHANDS_SUPPRESS_BANNER=true
