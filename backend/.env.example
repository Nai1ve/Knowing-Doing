NODE_ENV=development

MYSQL_ROOT_PASSWORD=replace-with-a-local-only-root-password

LAB_API_HOST=127.0.0.1
LAB_API_PORT=3000
LAB_CORS_ORIGIN=http://127.0.0.1:4175

LAB_MYSQL_HOST=127.0.0.1
LAB_MYSQL_PORT=13306
LAB_MYSQL_RUNNER_USER=zhixing_lab_runner
LAB_MYSQL_RUNNER_PASSWORD=
LAB_MYSQL_ADMIN_USER=zhixing_lab_admin
LAB_MYSQL_ADMIN_PASSWORD=
LAB_TOKEN_SECRET=replace-with-a-long-random-secret

LAB_RUN_LEASE_MS=1200000
LAB_RUN_IDLE_TIMEOUT_MS=300000
LAB_QUEUE_LEASE_MS=1800000
LAB_QUERY_TIMEOUT_MS=10000
LAB_MAX_ROWS=200
LAB_MAX_OUTPUT_BYTES=1048576
LAB_RUNNER_POOL_SIZE=6

ZHIXING_PRODUCT_DB_PATH=./data/zhixing-product.db
ZHIXING_MODEL_BASE_URL=
ZHIXING_MODEL_API_KEY=
ZHIXING_MODEL_NAME=default
ZHIXING_MODEL_TIMEOUT_MS=300000
ZHIXING_ZHIHU_CLI_PATH=
ZHIXING_RETRIEVAL_TIMEOUT_MS=15000
ZHIXING_RETRIEVAL_CACHE_TTL_MS=86400000
